# Environment Variables (Optional)

# Discord API - Main Account Token
DISCORD_TOKEN_MAIN=YOUR_MAIN_TOKEN_HERE

# Discord API - Alt Account Tokens (space or comma separated)
# Alternative: Use alts.txt file with one token per line
DISCORD_TOKENS_ALTS=ALT_TOKEN_1 ALT_TOKEN_2 ALT_TOKEN_3

# Webhooks
WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=nitrosniper.log

# Performance
MAX_CONCURRENT=50
CONNECTION_TIMEOUT=10

# Features
ENABLE_GIVEAWAY=true
ENABLE_INVITE=true
ENABLE_PRIVNOTE=false
ENABLE_WEBHOOK=true

# Delays (milliseconds)
MIN_DELAY=50
MAX_DELAY=200

# Jitter (percentage)
JITTER_PERCENT=15

